      unfold maximizingVertex
      apply (Nat.floor_eq_iff (by norm_num [T])).mpr
      norm_num [T]
    apply (epsilon_le_moment ((4:ℝ)/512) (1+(1:ℝ)/512) 437 (by rw [momentRange,ha]; norm_num)).trans
    unfold momentBound hingeMajorant
    rw [hv,show Nat.choose 565 437 = 7886712836741652757746764186662836215875257712073820056207876052959001457427495638705615155259707488590003488857057199670741252620 by rw [Nat.choose_eq_factorial_div_factorial (by decide)]; decide,show Nat.factorial 437 =  by decide]
    norm_num [T,Hstar,eps]
  · simp only [Nat.cast_ofNat,Nat.cast_one]
    have ha : ⌊(T-(1+(2:ℝ)/512))/((4:ℝ)/512)⌋₊ = 563 := (Nat.floor_eq_iff (by norm_num [T])).mpr (by norm_num [T])
    have hv : maximizingVertex ((T-(1+(2:ℝ)/512))/((4:ℝ)/512)) 437 = 565 := by
