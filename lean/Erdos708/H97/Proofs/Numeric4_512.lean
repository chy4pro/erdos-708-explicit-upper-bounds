  · simp only [Nat.cast_ofNat,Nat.cast_one]
    have ha : ⌊(T-(1+(1:ℝ)/512))/((4:ℝ)/512)⌋₊ = 564 := (Nat.floor_eq_iff (by norm_num [T])).mpr (by norm_num [T])
