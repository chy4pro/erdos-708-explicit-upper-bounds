    have ha : ⌊(T-(1+(3:ℝ)/128))/((4:ℝ)/128)⌋₊ = 140 := (Nat.floor_eq_iff (by norm_num [T])).mpr (by norm_num [T])
    have hv : maximizingVertex ((T-(1+(3:ℝ)/128))/((4:ℝ)/128)) 109 = 141 := by
