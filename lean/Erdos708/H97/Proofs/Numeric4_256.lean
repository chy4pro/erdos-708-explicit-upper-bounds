lemma eps_bound : ∀ d ∈ (Icc 1 4 : Finset ℕ), epsilon ((4:ℝ)/256) (1+(d:ℝ)/256) ≤ (eps[d-1]?.getD 0:ℚ) := by
  intro d hd
  obtain ⟨hd0,hd1⟩ := mem_Icc.mp hd
  interval_cases d
  · simp only [Nat.cast_ofNat,Nat.cast_one]
    have ha : ⌊(T-(1+(1:ℝ)/256))/((4:ℝ)/256)⌋₊ = 281 := (Nat.floor_eq_iff (by norm_num [T])).mpr (by norm_num [T])
    have hv : maximizingVertex ((T-(1+(1:ℝ)/256))/((4:ℝ)/256)) 219 = 283 := by
      unfold maximizingVertex
      apply (Nat.floor_eq_iff (by norm_num [T])).mpr
      norm_num [T]
    apply (epsilon_le_moment ((4:ℝ)/256) (1+(1:ℝ)/256) 219 (by rw [momentRange,ha]; norm_num)).trans
    unfold momentBound hingeMajorant
    rw [hv,show Nat.choose 283 219 = 28554210192944268772111815850470369329529259127026462633938271500 by rw [Nat.choose_eq_factorial_div_factorial (by decide)]; decide,show Nat.factorial 219 =  by decide]
    norm_num [T,Hstar,eps]
  · simp only [Nat.cast_ofNat,Nat.cast_one]
    have ha : ⌊(T-(1+(2:ℝ)/256))/((4:ℝ)/256)⌋₊ = 281 := (Nat.floor_eq_iff (by norm_num [T])).mpr (by norm_num [T])
    have hv : maximizingVertex ((T-(1+(2:ℝ)/256))/((4:ℝ)/256)) 219 = 283 := by
      unfold maximizingVertex
      apply (Nat.floor_eq_iff (by norm_num [T])).mpr
      norm_num [T]
    apply (epsilon_le_moment ((4:ℝ)/256) (1+(2:ℝ)/256) 219 (by rw [momentRange,ha]; norm_num)).trans
    unfold momentBound hingeMajorant
    rw [hv,show Nat.choose 283 219 = 28554210192944268772111815850470369329529259127026462633938271500 by rw [Nat.choose_eq_factorial_div_factorial (by decide)]; decide,show Nat.factorial 219 =  by decide]
    norm_num [T,Hstar,eps]
  · simp only [Nat.cast_ofNat,Nat.cast_one]
    have ha : ⌊(T-(1+(3:ℝ)/256))/((4:ℝ)/256)⌋₊ = 281 := (Nat.floor_eq_iff (by norm_num [T])).mpr (by norm_num [T])
    have hv : maximizingVertex ((T-(1+(3:ℝ)/256))/((4:ℝ)/256)) 218 = 282 := by
      unfold maximizingVertex
      apply (Nat.floor_eq_iff (by norm_num [T])).mpr
      norm_num [T]
    apply (epsilon_le_moment ((4:ℝ)/256) (1+(3:ℝ)/256) 218 (by rw [momentRange,ha]; norm_num)).trans
    unfold momentBound hingeMajorant
    rw [hv,show Nat.choose 282 218 = 22096720962031077247676634880752688633098613953423305006475199500 by rw [Nat.choose_eq_factorial_div_factorial (by decide)]; decide,show Nat.factorial 218 =  by decide]
    norm_num [T,Hstar,eps]
  · simp only [Nat.cast_ofNat,Nat.cast_one]
    have ha : ⌊(T-(1+(4:ℝ)/256))/((4:ℝ)/256)⌋₊ = 281 := (Nat.floor_eq_iff (by norm_num [T])).mpr (by norm_num [T])
    have hv : maximizingVertex ((T-(1+(4:ℝ)/256))/((4:ℝ)/256)) 218 = 282 := by
      unfold maximizingVertex
      apply (Nat.floor_eq_iff (by norm_num [T])).mpr
      norm_num [T]
    apply (epsilon_le_moment ((4:ℝ)/256) (1+(4:ℝ)/256) 218 (by rw [momentRange,ha]; norm_num)).trans
    unfold momentBound hingeMajorant
    rw [hv,show Nat.choose 282 218 = 22096720962031077247676634880752688633098613953423305006475199500 by rw [Nat.choose_eq_factorial_div_factorial (by decide)]; decide,show Nat.factorial 218 =  by decide]
    norm_num [T,Hstar,eps]
