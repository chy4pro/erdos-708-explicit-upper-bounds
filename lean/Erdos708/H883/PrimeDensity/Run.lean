/-- Chunk `i` passes: some hint list makes the walk over `[4096 i, 4096 (i+1))` succeed. -/
def ChunkOK (i : ℕ) : Prop :=
  ∃ L : List ℕ, run (4096 * i) 4096 (counts.getD i 0) L = some (counts.getD (i + 1) 0)

theorem range_zero {a : ℕ} : ∀ i, a ≤ i → i < a → ChunkOK i := by
  intro i h1 h2; omega

theorem range_succ {a n : ℕ} (h : ∀ i, a ≤ i → i < n → ChunkOK i) (hn : ChunkOK n) :
    ∀ i, a ≤ i → i < n + 1 → ChunkOK i := by
  intro i h1 h2
  rcases Nat.lt_or_ge i n with h3 | h3
  · exact h i h1 h3
  · obtain rfl : i = n := by omega
    exact hn

