import Erdos708.H883.PrimeDensity.Chunks0
import Erdos708.H883.PrimeDensity.Chunks1
import Erdos708.H883.PrimeDensity.Chunks2
import Erdos708.H883.PrimeDensity.Chunks3
import Erdos708.H883.PrimeDensity.Chunks4
import Erdos708.H883.PrimeDensity.Chunks5
import Erdos708.H883.PrimeDensity.Chunks6
import Erdos708.H883.PrimeDensity.Chunks7

/-!
Section 18, Lemma 18.6, the finite ranges (generated by `tools/gen_prime_density.py`):
`π(ν)/ν ≤ 9/40` on `[210, 32768)`, `≤ 3/20` on `[2310, 2^17)`, `≤ 1/8` on `[30030, 2^21)`.

`run` (in `PrimeDensity/Run.lean`) walks `n` upward with a running count `c`. A number equal to the
head of the hint list is counted; any other number must be `< 2` or have a divisor
`p ∈ smallPrimes` with `2 ≤ p < n`, so it is not prime. Therefore `c ≥ π(n)` regardless of the
hints (`run_spec`), and the three densities are checked at every `n`. The 512 chunks of 4096
are separate kernel checks in `PrimeDensity/Chunks0..7.lean`.
-/

namespace Erdos708H883.PrimeDensity

theorem all_chunks (i : ℕ) (hi : i < 512) : ChunkOK i := by
  by_cases h0 : i < 64
  · exact block_0 i (by omega) h0
  by_cases h1 : i < 128
  · exact block_1 i (by omega) h1
  by_cases h2 : i < 192
  · exact block_2 i (by omega) h2
  by_cases h3 : i < 256
  · exact block_3 i (by omega) h3
  by_cases h4 : i < 320
  · exact block_4 i (by omega) h4
  by_cases h5 : i < 384
  · exact block_5 i (by omega) h5
  by_cases h6 : i < 448
  · exact block_6 i (by omega) h6
  exact block_7 i (by omega) hi

theorem count_le : ∀ i, i ≤ 512 → Nat.count Nat.Prime (4096 * i) ≤ counts.getD i 0 := by
  intro i
  induction i with
  | zero => intro _; simp
  | succ i ih =>
      intro hi
      obtain ⟨L, h⟩ := all_chunks i (by omega)
      have := (run_spec 4096 (4096 * i) _ _ _ h (ih (by omega))).1
      rwa [show 4096 * i + 4096 = 4096 * (i + 1) by ring] at this

theorem dens_all (m : ℕ) (hm : m < 2097152) : densP m (Nat.count Nat.Prime (m + 1)) := by
  have hi : m / 4096 < 512 := by omega
  obtain ⟨L, h⟩ := all_chunks (m / 4096) hi
  exact (run_spec 4096 (4096 * (m / 4096)) _ _ _ h (count_le _ hi.le)).2 m (by omega) (by omega)

theorem primeCounting_eq (m : ℕ) : Nat.primeCounting m = Nat.count Nat.Prime (m + 1) := rfl

/-- Lemma 18.6, `π(ν)/ν ≤ 9/40` for `210 ≤ ν < 32768`. -/
theorem density_9_40 (ν : ℕ) (h1 : 210 ≤ ν) (h2 : ν < 32768) : 40 * Nat.primeCounting ν ≤ 9 * ν := by
  rw [primeCounting_eq]; exact (dens_all ν (by omega)).1 h1 h2

/-- Lemma 18.6, `π(ν)/ν ≤ 3/20` for `2310 ≤ ν < 2^17`. -/
theorem density_3_20 (ν : ℕ) (h1 : 2310 ≤ ν) (h2 : ν < 131072) : 20 * Nat.primeCounting ν ≤ 3 * ν := by
  rw [primeCounting_eq]; exact (dens_all ν (by omega)).2.1 h1 h2

/-- Lemma 18.6, `π(ν)/ν ≤ 1/8` for `30030 ≤ ν < 2^21`. -/
theorem density_1_8 (ν : ℕ) (h1 : 30030 ≤ ν) (h2 : ν < 2097152) : 8 * Nat.primeCounting ν ≤ ν := by
  rw [primeCounting_eq]; exact (dens_all ν (by omega)).2.2 h1 h2

end Erdos708H883.PrimeDensity
